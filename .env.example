# NexSite Backend LLM Provider Configuration
# Multiple comma-separated API keys for rotation & fallback

# Kimi (Moonshot AI) API Keys
KIMI_KEYS=sk-key1,sk-key2
KIMI_MODEL=moonshot-v1-8k

# Gemini API Keys
GEMINI_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-2.5-flash

# Groq API Keys
GROQ_KEYS=key1,key2
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter API Keys
OPENROUTER_KEYS=key1,key2
OPENROUTER_MODEL=deepseek/deepseek-chat-v3

# Together AI API Keys
TOGETHER_KEYS=key1,key2
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# HuggingFace API Keys
HUGGINGFACE_KEYS=key1,key2
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Active Provider Sequence (comma-separated order)
PROVIDER_SEQUENCE=Kimi,Gemini,Groq,OpenRouter,Together,HuggingFace

# Backend Server Port
PORT=3001

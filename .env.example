# ==============================================================================
# NexSite Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration (Required for Project & Code Persistence)
# ------------------------------------------------------------------------------
# Get your project URL and Anon Publishable Key from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration
# ------------------------------------------------------------------------------
PORT=3001

# ------------------------------------------------------------------------------
# 3. LLM Provider API Keys & Model Rotation
# You can provide multiple comma-separated keys for automatic load balancing & rotation
# ------------------------------------------------------------------------------

# Nvidia NIM API Keys
NVIDIA_KEYS=nvapi-key1,nvapi-key2
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# DeepSeek API Keys
DEEPSEEK_KEYS=sk-key1,sk-key2
DEEPSEEK_MODEL=deepseek-chat

# Groq API Keys
GROQ_KEYS=gsk_key1,gsk_key2
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Keys
GEMINI_KEYS=AIzaSy_key1,AIzaSy_key2
GEMINI_MODEL=gemini-2.5-flash

# Kimi (Moonshot AI) API Keys
KIMI_KEYS=sk-key1,sk-key2
KIMI_MODEL=moonshot-v1-8k

# OpenRouter API Keys
OPENROUTER_KEYS=sk-or-key1,sk-or-key2
OPENROUTER_MODEL=deepseek/deepseek-chat-v3

# Together AI API Keys
TOGETHER_KEYS=key1,key2
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# HuggingFace API Keys
HUGGINGFACE_KEYS=hf_key1,hf_key2
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ------------------------------------------------------------------------------
# 4. Active Provider Sequence
# Comma-separated order of fallback priority. If the first fails, it rotates to next.
# ------------------------------------------------------------------------------
PROVIDER_SEQUENCE=Groq,Gemini,OpenRouter,Nvidia,DeepSeek,Together,Kimi,HuggingFace
